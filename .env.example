# Copie para /etc/talos/secrets.env (dono talos, permissão 0600). NUNCA versionar o real.
# Atenção: o systemd NÃO aceita comentários na mesma linha de um valor; comentários só em linhas próprias.

# Modo de autenticação: subscription (padrão) | api_key (plano B, desligado)
AUTH_MODE=subscription
# Gerado com `claude setup-token` (nunca no git)
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY NÃO pode existir no ambiente em modo subscription
# CLAUDE_CLI_PATH vazio = CLI embutido no claude-agent-sdk (fixado com o SDK)
CLAUDE_CLI_PATH=
# pro | max5 | max20 (define o teto diário e se o planejamento usa Opus)
CLAUDE_PLAN=pro

# Sistema 1 (Jev, TypeSafe): roteamento, triagem, injeção, classificador e organização do Gmail
# SYSTEM1: jev | off
SYSTEM1=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

AGENT_NAME=Talos
TIMEZONE=Europe/Lisbon
QUIET_HOURS=22:30-08:00
MAX_CONCURRENT_AGENTS=1
# Vazio = padrão do plano (pro 30, max5 60, max20 150)
DAILY_RUN_SOFT_LIMIT=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
# Onde chegam os avisos e os cartões de aprovação: telegram, app (notificações do PWA) ou os dois
# Exemplos: telegram,app (padrão) | app | telegram
NOTIFY_CHANNELS=telegram,app

GMAIL_ADDRESS=
# Resulta em <gmail>+talos@gmail.com
AGENT_INBOX_TAG=talos
GOOGLE_OAUTH_CLIENT_FILE=/etc/talos/google_client.json

VAULT_KEY_FILE=/etc/talos/vault.key
DATA_DIR=/var/lib/talos
WORKSPACE_DIR=/srv/talos/workspace

BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
MASCOT_MODEL=/assets/talos.glb
SENTINEL_CLASSIFIER=on

# App (PWA), exposto só por `tailscale serve`
API_HOST=127.0.0.1
API_PORT=8000
# Logins Tailscale autorizados, separados por vírgula (ex.: lucas@github)
ALLOWED_TAILSCALE_LOGINS=
# PIN opcional do app
APP_PIN=

# Prazos (encurte na configuração de teste)
APPROVAL_TTL_HOURS=48
APPROVAL_REMINDER_HOURS=24
FOLLOWUP_BUSINESS_DAYS=3
MAX_FOLLOWUPS=2
MONITOR_INTERVAL_SECONDS=180
BRIEFING_TIME=08:30
REFLECTION_TIME=23:00
ORGANIZE_TIME=09:00
