[Unit]
Description=Talos — "Tela": x11vnc no :99 + noVNC em 127.0.0.1:6080 (exposto só por tailscale serve)
After=talos-browser.service
Requires=talos-browser.service

[Service]
Type=simple
User=talos
Group=talos
ExecStartPre=/bin/sleep 2
ExecStart=/bin/bash -c 'x11vnc -display :99 -localhost -rfbport 5900 -forever -shared -rfbauth /etc/talos/vnc.pass -quiet & exec websockify --web /usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900'
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# sem PrivateTmp: precisa do socket X do talos-browser em /tmp/.X11-unix

[Install]
WantedBy=multi-user.target
