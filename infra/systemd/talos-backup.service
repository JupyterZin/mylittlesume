[Unit]
Description=Talos — backup diário (banco + memória)

[Service]
Type=oneshot
User=talos
Group=talos
EnvironmentFile=-/etc/talos/backup.env
ExecStart=/opt/talos/infra/scripts/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
# /tmp privado e gravável (com ProtectSystem=strict o /tmp do sistema fica só-leitura e o mktemp falhava)
PrivateTmp=yes
ReadWritePaths=/var/lib/talos
ReadOnlyPaths=/srv/talos/workspace
